
---
import Layout from "../layouts/Layout.astro";

const github = "https://github.com/alaa-masaoud";
const linkedin = "https://www.linkedin.com/in/alaa-masaoud-9903152bb/";
const email = "amasaoud005@gmail.com";

const research = [
  {
    category: "Extreme Value Theory",
    title: "Tail Parameter Estimation for Integrated Information",
    description:
      "A simulation study comparing tail-parameter estimation methods for extreme value distributions, with the goal of improving confidence intervals for estimates of minimum integrated information.",
    details:
      "Methods were evaluated using confidence interval coverage, average interval length, bias, variance, and an overall quality score. Grimshaw MLE showed the strongest overall performance among methods with estimated tail parameters.",
    tags: ["Statistics", "Extreme Value Theory", "Simulation", "R"],
    link: "https://github.com/alaa-masaoud/CI_min",
    linkText: "View Research",
    status: "Research Project"
  },
  {
    category: "Honours Thesis",
    title: "Minimum Information Partitions and Queyranne's Algorithm",
    description:
      "Investigating mathematical and computational approaches to identifying minimum information partitions within Integrated Information Theory.",
    details:
      "Current work focuses on symmetric submodular minimization, maximum adjacency orderings, contraction methods, and implementing Queyranne's algorithm in Python.",
    tags: ["Optimization", "Algorithms", "Python", "Mathematics"],
    link: github,
    linkText: "Explore GitHub",
    status: "In Progress"
  }
];

const projects = [
  {
    number: "01",
    title: "Genetic Algorithm for Vigenère Cryptanalysis",
    description:
      "Exploring evolutionary optimization techniques for recovering encryption keys and evaluating the effectiveness of genetic algorithms.",
    tags: ["Python", "Genetic Algorithms", "Optimization"]
  },
  {
    number: "02",
    title: "Reinforcement Learning Experiments",
    description:
      "Implementing and comparing reinforcement learning approaches using environments such as Taxi-v3 and LunarLander.",
    tags: ["Python", "Reinforcement Learning", "AI"]
  },
  {
    number: "03",
    title: "Statistical Learning and Classification",
    description:
      "Statistical modelling work involving regularization, regression, classification, and predictive model evaluation.",
    tags: ["R", "Statistics", "Machine Learning"]
  },
  {
    number: "04",
    title: "Cancer Survival and Prediction Studies",
    description:
      "Planned independent research exploring survival analysis, cancer outcome prediction, and statistical learning methods using publicly available datasets.",
    tags: ["Biostatistics", "Survival Analysis", "Research"],
    upcoming: true
  }
];

const interests = [
  "Biostatistics",
  "Statistical Inference",
  "Extreme Value Theory",
  "Survival Analysis",
  "Mathematical Optimization",
  "Predictive Modelling"
];
---

<Layout
  title="Alaa Masaoud | Research & Academic Portfolio"
  description="Academic portfolio of Alaa Masaoud, featuring research in statistics, artificial intelligence, extreme value theory, and mathematical optimization."
>
  <!-- NAVIGATION -->
  <header class="site-header">
    <div class="container nav-container">
      <a href="#home" class="logo" aria-label="Alaa Masaoud homepage">
        AM<span>.</span>
      </a>

      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#goals">Goals</a>
        <a href="#research">Research</a>
        <a href="#projects">Projects</a>
        <a href="#achievements">Achievements</a>
        <a href="#cv">CV</a>
        <a href="#contact">Contact</a>
      </nav>

      <div class="nav-socials">
        <a href={linkedin} target="_blank" rel="noopener noreferrer" class="nav-linkedin">
          LinkedIn ↗
        </a>
        <a href={github} target="_blank" rel="noopener noreferrer" class="nav-button">
          GitHub ↗
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section id="home" class="hero">
      <div class="container hero-content">
        <div class="hero-text">
          <div class="eyebrow">
            <span class="eyebrow-line"></span>
            COMPUTER SCIENCE · STATISTICS · RESEARCH
          </div>

          <h1>
            Hello, I'm <br />
            <span>Alaa Masaoud.</span>
          </h1>

          <p class="hero-description">
            An Honours Computer Science student specializing in
            Artificial Intelligence at Brock University, with a
            growing focus on statistics, mathematical research,
            and computational methods.
          </p>

          <p class="hero-secondary">
            Exploring how statistical theory and computational tools
            can help us understand complex problems and make
            better decisions.
          </p>

          <div class="hero-actions">
            <a href="#research" class="button button-primary">
              Explore My Research <span>↗</span>
            </a>
            <a href="#about" class="button button-outline">
              More About Me
            </a>
          </div>

          <div class="hero-meta">
            <div>
              <span class="meta-label">UNIVERSITY</span>
              <strong>Brock University</strong>
            </div>
            <div>
              <span class="meta-label">ACADEMIC FOCUS</span>
              <strong>Statistics & Artificial Intelligence</strong>
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <figure class="hero-photo">
            <img
              src="/award-photo.jpg"
              alt="Alaa Masaoud holding his Best Poster Presentation award certificate at the Undergraduate Research Symposium"
              loading="eager"
              fetchpriority="high"
            />
            <figcaption>
              <span>Best Poster Presentation</span>
              <span>Undergraduate Research Symposium · 2026</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="section">
      <div class="container about-grid">
        <div>
          <span class="section-label">01 / ABOUT ME</span>
          <h2 class="section-title">
            A curiosity for <em>complex problems.</em>
          </h2>
        </div>

        <div class="about-content">
          <p class="lead">
            My academic interests sit at the crossroads of
            computer science, statistics, and math.
          </p>

          <p>
            I am in my fourth year of pursuing a BSc Honours degree in Computer Science
            with a specialization in Artificial Intelligence at
            Brock University. Alongside my computer science studies,
            I have developed a strong interest in statistical methods,
            probability, and mathematical modelling.
          </p>

          <p>
            My research experience includes investigating extreme
            value distributions and tail-parameter estimation, as well
            as studying optimization methods for Integrated
            Information Theory through my undergraduate honours thesis.
          </p>

          <p>
            I enjoy working on problems that combine mathematical
            reasoning, statistical analysis, and computational
            implementation.
          </p>

          <div class="interest-block">
            <h3>Areas of Interest</h3>
            <div class="tags">
              {interests.map((interest) => (
                <span class="tag">{interest}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FUTURE GOALS -->
    <section id="goals" class="section goals-section">
      <div class="container">
        <span class="section-label light-label">02 / LOOKING AHEAD</span>

        <h2 class="section-title light-title">
          Where I hope <br />
          <em>to go next.</em>
        </h2>

        <div class="goals-grid">
          <div class="goals-main">
            <p class="goals-lead">
              I hope to pursue graduate studies that allow me to
              deepen my understanding of statistical theory and
              its applications to meaningful real-world problems.
            </p>

            <p>
              Following my undergraduate degree, I intend to pursue
              an MSc in Biostatistics, Statistics, or Actuarial Science.
            </p>

            <p>
              I am especially interested in applications involving
              healthcare outcomes, survival analysis, risk assessment,
              statistical learning, and uncertainty quantification.
            </p>

            <p>
              In the longer term, I hope to contribute to research
              and industry projects where rigorous statistical
              methods can support better decisions.
            </p>
          </div>

          <div class="goals-cards">
            <div class="goal-card">
              <span class="goal-number">01</span>
              <h3>Graduate Studies</h3>
              <p>
                Pursuing advanced training in statistical inference,
                modelling, and applied research.
              </p>
            </div>

            <div class="goal-card">
              <span class="goal-number">02</span>
              <h3>Applied Research</h3>
              <p>
                Developing statistical methods for healthcare,
                risk analysis, and predictive modelling.
              </p>
            </div>

            <div class="goal-card">
              <span class="goal-number">03</span>
              <h3>Professional Growth</h3>
              <p>
                Building a career that combines analytical
                problem-solving with meaningful applications.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- RESEARCH -->
    <section id="research" class="section">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-label">03 / RESEARCH</span>
            <h2 class="section-title">
              Research & <em>exploration.</em>
            </h2>
          </div>

          <p class="section-intro">
            Investigating questions in statistics,
            mathematical optimization, and computational research.
          </p>
        </div>

        <div class="research-grid">
          {research.map((item) => (
            <article class="research-card">
              <div class="card-top">
                <span class="card-category">{item.category}</span>
                <span class="status">{item.status}</span>
              </div>

              <h3>{item.title}</h3>

              <p>{item.description}</p>
              <p class="research-details">{item.details}</p>

              <div class="tags">
                {item.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>

              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="text-link"
              >
                {item.linkText} <span>↗</span>
              </a>
            </article>
          ))}
        </div>

        <div class="research-note">
          <span class="note-icon">✦</span>
          <p>
            My undergraduate research has been supervised by
            Dr. William Marshall at Brock University.
          </p>
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects" class="section projects-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="section-label">04 / TECHNICAL WORK</span>
            <h2 class="section-title">
              Selected <em>projects.</em>
            </h2>
          </div>

          <p class="section-intro">
            A collection of computational and statistical projects
            developed through coursework, independent learning,
            and research.
          </p>
        </div>

        <div class="projects-list">
          {projects.map((project) => (
            <article class="project-item">
              <span class="project-number">{project.number}</span>

              <div class="project-info">
                <div class="project-title-row">
                  <h3>{project.title}</h3>
                  {project.upcoming && (
                    <span class="upcoming">PLANNED</span>
                  )}
                </div>

                <p>{project.description}</p>

                <div class="tags">
                  {project.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="projects-footer">
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="button button-primary"
          >
            View My GitHub <span>↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ACHIEVEMENTS -->
    <section id="achievements" class="section">
      <div class="container achievements-grid">
        <div>
          <span class="section-label">05 / ACHIEVEMENTS</span>
          <h2 class="section-title">
            Milestones & <em>recognition.</em>
          </h2>

          <p class="achievements-intro">
            Selected highlights from my academic and
            research experience.
          </p>
        </div>

        <div class="achievement-list">
          <div class="achievement">
            <span class="achievement-year">2026</span>
            <div>
              <h3>Best Poster Presentation</h3>
              <p>
                Undergraduate Research Symposium —
                recognition for my research presentation.
              </p>
            </div>
          </div>

          <div class="achievement">
            <span class="achievement-year">ONGOING</span>
            <div>
              <h3>Undergraduate Honours Thesis</h3>
              <p>
                Research on minimum information partitions,
                symmetric submodular optimization, and
                Queyranne's algorithm.
              </p>
            </div>
          </div>

          <div class="achievement">
            <span class="achievement-year">RESEARCH</span>
            <div>
              <h3>Extreme Value Theory Simulation Study</h3>
              <p>
                Comparative evaluation of tail-parameter
                estimation methods and confidence interval performance.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CV -->
    <section id="cv" class="section cv-section">
      <div class="container cv-container">
        <div>
          <span class="section-label">06 / CURRICULUM VITAE</span>
          <h2 class="section-title">
            Academic <em>CV.</em>
          </h2>

          <p>
            My CV will include my education, research experience,
            technical skills, academic projects, presentations,
            and achievements.
          </p>
        </div>

        <div class="cv-action">
          <span class="cv-icon" aria-hidden="true">↗</span>
          <p>CV currently being prepared</p>
          <span class="cv-coming-soon">COMING SOON</span>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section contact-section">
      <div class="container contact-container">
        <span class="section-label light-label">07 / GET IN TOUCH</span>

        <h2>Let's connect<span>.</span></h2>

        <p>
          I welcome opportunities to connect with students,
          researchers, and professionals interested in statistics,
          artificial intelligence, and applied research.
        </p>

        <a href={`mailto:${email}`} class="contact-email">
          {email}
        </a>

        <div class="contact-links">
          <a href={`mailto:${email}`} class="button button-light">
            Email Me ↗
          </a>

          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="button button-contact-outline"
          >
            LinkedIn ↗
          </a>

          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="button button-contact-outline"
          >
            GitHub ↗
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container footer-content">
      <a href="#home" class="footer-logo">AM<span>.</span></a>

      <p>© {new Date().getFullYear()} Alaa Masaoud</p>

      <div class="footer-links">
        <a href={`mailto:${email}`}>Email</a>
        <a href={linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn
        </a>
        <a href={github} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .container {
    width: min(1160px, calc(100% - 48px));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(247, 245, 239, 0.96);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }

  .nav-container {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .logo,
  .footer-logo {
    font-family: var(--font-heading);
    font-size: 29px;
    font-weight: 700;
    text-decoration: none;
    color: var(--forest);
  }

  .logo span,
  .footer-logo span {
    color: var(--gold);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  nav a {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: var(--forest-light);
  }

  .nav-socials {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nav-linkedin {
    font-size: 13px;
    font-weight: 700;
    color: var(--forest);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-linkedin:hover {
    color: var(--forest-light);
  }

  .nav-button {
    background: var(--forest);
    color: white;
    text-decoration: none;
    padding: 11px 20px;
    border-radius: 5px;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  .hero {
    padding: 105px 0 100px;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 65px;
  }

  .eyebrow,
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--forest-light);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .eyebrow-line {
    width: 30px;
    height: 1px;
    background: var(--gold);
  }

  .hero h1 {
    margin: 24px 0 28px;
    color: var(--forest);
    font-size: clamp(54px, 6vw, 90px);
    letter-spacing: -3px;
  }

  .hero h1 span {
    font-style: italic;
    font-weight: 400;
  }

  .hero-description {
    font-size: 19px;
    line-height: 1.8;
    max-width: 610px;
    color: var(--text);
  }

  .hero-secondary {
    max-width: 550px;
    margin-top: 18px;
    font-size: 15px;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 13px 23px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 5px;
    transition: transform 0.2s, background 0.2s;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--forest);
    color: white;
  }

  .button-primary:hover {
    background: var(--forest-light);
  }

  .button-outline {
    border: 1px solid var(--forest);
    color: var(--forest);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    margin-top: 60px;
    padding-top: 25px;
    border-top: 1px solid var(--border);
  }

  .hero-meta div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .meta-label {
    font-size: 10px;
    letter-spacing: 1.5px;
    color: var(--muted);
    font-weight: 700;
  }

  .hero-meta strong {
    font-size: 13px;
    color: var(--forest);
  }

  .hero-visual {
    min-width: 0;
  }

  
.hero-photo {
  margin: 0;
  width: 100%;
  overflow: hidden;
  background: #FFFFFF;
  border: 1px solid var(--border);
  box-shadow: 0 18px 45px rgba(24, 60, 52, 0.08);
}


  
.hero-photo img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
}


  .hero-photo figcaption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 22px;
    background: #fff;
  }

  .hero-photo figcaption span:first-child {
    color: var(--forest);
    font-weight: 700;
    font-size: 13px;
  }

  .hero-photo figcaption span:last-child {
    color: var(--muted);
    font-size: 12px;
  }

  .section {
    padding: 105px 0;
  }

  .section-title {
    margin: 20px 0 0;
    font-size: clamp(39px, 4vw, 58px);
    color: var(--forest);
    letter-spacing: -1.5px;
  }

  .section-title em {
    font-weight: 400;
  }

  .about-grid,
  .achievements-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 100px;
  }

  .about-content p {
    font-size: 15px;
    color: var(--muted);
    margin: 0 0 20px;
  }

  .about-content .lead {
    color: var(--forest);
    font-size: 22px;
    line-height: 1.6;
    font-weight: 600;
  }

  .interest-block {
    margin-top: 35px;
  }

  .interest-block h3 {
    color: var(--forest);
    font-size: 22px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    display: inline-block;
    padding: 6px 12px;
    background: #EDF0E8;
    border: 1px solid #E0E5D9;
    border-radius: 4px;
    color: var(--forest);
    font-size: 11px;
    font-weight: 600;
  }

  .goals-section {
    background: var(--forest);
    color: #E5ECE6;
  }

  .light-label {
    color: var(--gold);
  }

  .light-title {
    color: white;
  }

  .goals-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 100px;
    margin-top: 55px;
  }

  .goals-main p {
    font-size: 15px;
    color: #C6D5CD;
    margin: 0 0 23px;
  }

  .goals-main .goals-lead {
    color: white;
    font-size: 23px;
    line-height: 1.65;
  }

  .goals-cards {
    display: grid;
    gap: 15px;
  }

  .goal-card {
    border: 1px solid rgba(255, 255, 255, 0.16);
    padding: 24px;
    background: rgba(255, 255, 255, 0.035);
  }

  .goal-number {
    color: var(--gold);
    font-size: 12px;
    font-weight: 700;
  }

  .goal-card h3 {
    color: white;
    font-size: 21px;
    margin: 8px 0;
  }

  .goal-card p {
    font-size: 13px;
    color: #C6D5CD;
    margin: 0;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 50px;
    margin-bottom: 45px;
  }

  .section-intro {
    max-width: 350px;
    color: var(--muted);
    font-size: 14px;
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .research-card {
    background: white;
    border: 1px solid var(--border);
    padding: 36px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .research-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(24, 60, 52, 0.07);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 25px;
  }

  .card-category {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--forest-light);
  }

  .status,
  .upcoming {
    font-size: 10px;
    font-weight: 700;
    color: #8A6B36;
    background: #F6EEDA;
    padding: 5px 9px;
    border-radius: 3px;
  }

  .research-card h3 {
    color: var(--forest);
    font-size: 28px;
    margin-bottom: 18px;
  }

  .research-card p {
    color: var(--muted);
    font-size: 14px;
    margin: 0 0 15px;
